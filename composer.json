{
    "name": "samlitowitz/psalm-no-double-quoted-strings",
    "description": "Do not allow double-quoted strings",
    "type": "psalm-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Sam Litowitz",
            "email": "samlitowitz@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "vimeo/psalm": "dev-master || ^6.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0.0",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "extra": {
        "psalm" : {
            "pluginClass": "SamLitowitz\\Psalm\\Plugin\\NoDoubleQuotedStrings"
        }
    },
    "autoload": {
        "psr-4": {
            "SamLitowitz\\Psalm\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SamLitowitz\\Psalm\\Plugin\\Tests\\": "tests"
        }
    },
    "scripts" : {
        "check": [
            "@cs-check",
            "@test",
            "@analyze"
        ],
        "analyze": "psalm",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
